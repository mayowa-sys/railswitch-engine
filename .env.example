# --- Core -------------------------------------------------------------------
# Matches docker-compose.yml. The connecting role owns the tables; tenant
# requests switch to the unprivileged railswitch_app role (see src/db/client.ts).
DATABASE_URL=postgres://railswitch:railswitch_dev@localhost:5432/railswitch
REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=3001

# --- Secrets (required in production) ---------------------------------------
# Signs customer self-service portal tokens.
PORTAL_SECRET=
PORTAL_URL=http://localhost:3100
# Signs outbound webhooks to merchants.
WEBHOOK_SECRET=
# Verifies inbound Nomba webhooks.
NOMBA_WEBHOOK_SECRET=

# --- Nomba ------------------------------------------------------------------
# Leave empty to run against the deterministic mock client.
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
NOMBA_SUB_ACCOUNT_ID=
NOMBA_BASE_URL=https://sandbox.nomba.com

# --- Notification rails (optional) ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
RESEND_API_KEY=
SMTP_FROM=

# --- AI (optional; everything falls back to rules/templates without it) -----
GEMINI_API_KEY=
GEMINI_MODEL=
RAILSWITCH_AI_DUNNING=on
RAILSWITCH_AI_RETRY=on
